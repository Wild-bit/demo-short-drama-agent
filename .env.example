
DEEPSEEK_API_KEY=你的真实Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# normal 使用 DeepSeek 官方窗口，单次输出上限为 16K。lesson 用于快速验证第七课。
AGENT_CONTEXT_PROFILE=normal
# 可选。教学模式下可以覆盖默认的 16000 窗口，包含输出预留和估算余量。
# AGENT_CONTEXT_WINDOW_TOKENS=6500
# NestJS 服务端口
PORT=3000

# Nest 运行在宿主机，MySQL 由 Docker Compose 启动
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=short_drama
MYSQL_USER=short_drama
MYSQL_PASSWORD=replace_with_local_database_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
