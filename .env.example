
DEEPSEEK_API_KEY=你的真实Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# normal 使用 DeepSeek 官方窗口，单次输出上限为 16K。lesson 用于快速验证第七课。
AGENT_CONTEXT_PROFILE=normal
# 可选。教学模式下可以覆盖默认的 16000 窗口，包含输出预留和估算余量。
# AGENT_CONTEXT_WINDOW_TOKENS=6500
# NestJS 服务端口
PORT=3000

# 已有素材的固定 CDN 域名。素材 URL 由此域名和 COS 对象 Key 组成。
ASSET_CDN_ORIGIN=https://resource.lancespace.club

# 服务端用专用 CAM 身份向腾讯云 STS 申请上传临时凭证。
COS_BUCKET=lance-bucket-1328693273
COS_REGION=ap-guangzhou
COS_STS_SECRET_ID=
COS_STS_SECRET_KEY=

# 千问 AI 平台按量付费媒体模型使用共享的原生 API。
ALIYUN_AI_API_KEY=
ALIYUN_AI_BASE_URL=https://maas.qianwenaiapi.com/api/v1
# 百炼专属域名接入时，地域和业务空间 ID 需与 API Key 对应。
ALIYUN_AI_REGION=cn-beijing
ALIYUN_AI_WORKSPACE_ID=
ALIYUN_AI_IMAGE_MODEL=wan2.7-image
ALIYUN_AI_KLING_IMAGE_MODEL=kling/kling-v3-omni-image-generation
ALIYUN_AI_VIDEO_MODEL=wan3.0-video

# Nest 运行在宿主机，MySQL 由 Docker Compose 启动
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=short_drama
MYSQL_USER=short_drama
MYSQL_PASSWORD=replace_with_local_database_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
